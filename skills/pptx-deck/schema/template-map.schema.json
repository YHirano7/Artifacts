{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pptx-deck template map",
  "type": "object",
  "required": ["template", "components"],
  "additionalProperties": false,
  "properties": {
    "template": {"type": "string", "minLength": 1},
    "slide_size": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0},
      "minItems": 2,
      "maxItems": 2
    },
    "placeholder_markers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/component"}
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["kind", "source", "slots"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["structural", "content"]},
        "source": {
          "type": "object",
          "oneOf": [
            {"required": ["layout"]},
            {"required": ["sample_slide"]}
          ],
          "properties": {
            "layout": {"type": "string", "minLength": 1},
            "sample_slide": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/slot"}
        },
        "notes_instructions": {"type": "string"}
      }
    },
    "slot": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["text", "list", "table", "orgchart", "timeline",
                          "chart"]},
        "target": {},
        "required": {"type": "boolean"},
        "node_prototype": {"type": "string", "minLength": 1},
        "connector_color": {"type": "string", "minLength": 1},
        "table_style_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

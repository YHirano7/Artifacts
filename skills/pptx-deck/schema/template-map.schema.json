{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pptx-deck template map",
  "type": "object",
  "required": ["template", "components"],
  "additionalProperties": false,
  "properties": {
    "template": {"type": "string", "minLength": 1},
    "policy": {
      "type": "object",
      "properties": {
        "text_only": {"enum": ["error", "warn", "allow"]},
        "max_message_slides": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "target": {"enum": ["powerpoint", "google_slides"]}
      },
      "additionalProperties": false
    },
    "slide_size": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0},
      "minItems": 2,
      "maxItems": 2
    },
    "canvas": {
      "type": "object",
      "properties": {
        "layout": {"type": "string", "minLength": 1},
        "title": {"type": "integer", "minimum": 0},
        "region": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 4,
          "maxItems": 4
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "object",
          "properties": {
            "primary": {"$ref": "#/definitions/color"},
            "highlight": {"$ref": "#/definitions/color"},
            "text": {"$ref": "#/definitions/color"},
            "muted": {"$ref": "#/definitions/color"},
            "surface": {"$ref": "#/definitions/color"},
            "line": {"$ref": "#/definitions/color"},
            "background": {"$ref": "#/definitions/color"}
          },
          "additionalProperties": false
        },
        "fonts": {
          "type": "object",
          "properties": {
            "latin": {"type": "string", "minLength": 1},
            "ea": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "sizes": {
          "type": "object",
          "properties": {
            "heading": {
              "type": "integer", "minimum": 11, "maximum": 72, "default": 20
            },
            "body": {
              "type": "integer", "minimum": 11, "maximum": 72, "default": 16
            },
            "caption": {
              "type": "integer", "minimum": 11, "maximum": 72, "default": 13
            },
            "number": {
              "type": "integer", "minimum": 11, "maximum": 72, "default": 48
            },
            "min": {
              "type": "integer", "minimum": 11, "maximum": 72, "default": 11
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "placeholder_markers": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/definitions/component"}
    }
  },
  "definitions": {
    "color": {
      "type": "string",
      "pattern": "^(#[0-9A-Fa-f]{6}|accent[1-6]|dk[12]|lt[12]|tx[12]|bg[12])$"
    },
    "component": {
      "type": "object",
      "required": ["kind", "source", "slots"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["structural", "content"]},
        "source": {
          "type": "object",
          "oneOf": [
            {"required": ["layout"]},
            {"required": ["sample_slide"]}
          ],
          "properties": {
            "layout": {"type": "string", "minLength": 1},
            "sample_slide": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "slots": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/definitions/slot"}
        },
        "notes_instructions": {"type": "string"}
      }
    },
    "slot": {
      "type": "object",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {"enum": ["text", "list", "table", "orgchart", "timeline",
                          "chart"]},
        "target": {},
        "required": {"type": "boolean"},
        "node_prototype": {"type": "string", "minLength": 1},
        "connector_color": {"type": "string", "minLength": 1},
        "table_style_id": {"type": "string", "minLength": 1}
      }
    }
  }
}

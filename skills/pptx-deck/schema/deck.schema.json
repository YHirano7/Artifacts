{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pptx-deck deck spec",
  "type": "object",
  "required": ["story", "meta", "slides"],
  "additionalProperties": false,
  "properties": {
    "story": {
      "type": "object",
      "required": ["purpose", "audience", "desired_action", "key_message"],
      "additionalProperties": false,
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "desired_action": {"type": "string", "minLength": 1},
        "key_message": {"type": "string", "minLength": 1}
      }
    },
    "meta": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["component", "slots"],
        "additionalProperties": false,
        "properties": {
          "component": {"type": "string", "minLength": 1},
          "variant": {"type": "string", "minLength": 1},
          "message": {"type": ["string", "null"]},
          "slots": {
            "type": "object",
            "minProperties": 1
          },
          "notes": {"type": "string"}
        }
      }
    }
  }
}
